{
  "version": 3,
  "configurePresets": [
    {
      "name": "vcpkg",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "release",
      "inherits": "vcpkg",
      "generator": "Ninja",
      "binaryDir": "build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SUPPRESS_DEVELOPER_WARNINGS": "TRUE"
      }
    },
    {
      "name": "debug",
      "inherits": "vcpkg",
      "generator": "Ninja",
      "binaryDir": "build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_SUPPRESS_DEVELOPER_WARNINGS": "TRUE"
      }
    },
    {
      "name": "profile",
      "inherits": "vcpkg",
      "generator": "Ninja",
      "binaryDir": "build/profile",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Profile",
        "CMAKE_SUPPRESS_DEVELOPER_WARNINGS": "TRUE"
      }
    }
  ]
}
